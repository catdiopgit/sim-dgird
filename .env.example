# URL du projet Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique "anon" du projet Supabase (Project Settings > API)
# Ne jamais utiliser la clé "service_role" côté frontend.
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nom de l'application (affiché dans l'en-tête, les emails, etc.)
VITE_APP_NAME=SIM

# --- Backend NestJS (server/) — migration TypeORM/PostgreSQL direct ---
# Voir MIGRATION.md pour le contexte.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=postgres
# true uniquement si la base exige TLS (ex: instance Supabase managée)
DB_SSL=false

# Secret de signature des JWT — générer une valeur forte et unique par environnement,
# ex: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Port d'écoute de l'API NestJS
PORT=3001
