# URL de base de l'API NestJS (server/) consommée par le frontend — Phase 8
# de MIGRATION.md, remplace @supabase/supabase-js. Vide en local -> défaut
# http://localhost:3001/api (voir src/config/env.ts).
VITE_API_URL=

# Nom de l'application (affiché dans l'en-tête, les emails, etc.)
VITE_APP_NAME=SIM

# --- Backend NestJS (server/) — migration TypeORM/PostgreSQL direct ---
# Voir MIGRATION.md pour le contexte.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=postgres
# true uniquement si la base exige TLS (ex: instance Supabase managée)
DB_SSL=false

# Secret de signature des JWT — générer une valeur forte et unique par environnement,
# ex: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Clé de chiffrement réversible (AES-256-GCM) pour les secrets que l'app doit pouvoir
# relire en clair (ex: mot de passe SMTP) — ne JAMAIS réutiliser JWT_SECRET pour ceci.
# ex: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Port d'écoute de l'API NestJS
PORT=3001

# Racine de stockage des pièces jointes/décharges courrier (disque local, décision d
# de MIGRATION.md — pas de MinIO/S3). À définir en chemin ABSOLU et HORS du dossier
# de déploiement en production (ex: D:\sim-dgird-storage sur le VPS), pour ne pas
# risquer de perdre les fichiers à chaque redéploiement. Vide en local -> ./storage
# à la racine du dépôt (voir server/config/storage.config.ts).
STORAGE_ROOT=
