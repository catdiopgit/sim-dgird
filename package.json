{
  "name": "sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server:dev": "nest start --watch",
    "server:build": "nest build",
    "server:start:prod": "node dist-server/main.js",
    "migration:generate": "cross-env TS_NODE_PROJECT=server/tsconfig.json typeorm-ts-node-commonjs migration:generate -d server/config/data-source.ts",
    "migration:run": "cross-env TS_NODE_PROJECT=server/tsconfig.json typeorm-ts-node-commonjs migration:run -d server/config/data-source.ts",
    "migration:revert": "cross-env TS_NODE_PROJECT=server/tsconfig.json typeorm-ts-node-commonjs migration:revert -d server/config/data-source.ts",
    "migrate:passwords": "cross-env TS_NODE_PROJECT=server/tsconfig.json ts-node server/scripts/migrate-passwords.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@hookform/resolvers": "^5.7.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.5.4",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.21",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "oxlint": "^1.75.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
